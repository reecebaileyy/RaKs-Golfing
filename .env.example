# Database (Postgres). DATABASE_URL_UNPOOLED is the direct connection migrations use;
# locally both can be the same.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/raks"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/raks"

# Pre-launch landing page: "waitlist" makes / the waitlist and closes the rest of the app.
SITE_MODE=""
# Public address, for invite links and social login callbacks.
APP_URL="http://localhost:3000"
# 32+ random characters; signs the cookies used during social sign-in.
AUTH_SECRET=""
# These emails become admins after signing in with a code.
ADMIN_EMAILS=""
CONTACT_EMAIL=""

# Sign-in codes. Without these, codes are printed in the server log.
RESEND_API_KEY=""
EMAIL_FROM=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Social logins; each button shows once both of its keys are set.
X_CLIENT_ID=""
X_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

# Local testing only, never in production: fake social consent page, codes shown on screen.
OAUTH_MOCK=""
LOGIN_CODE_ECHO=""

# Optional: Google Weather (falls back to Open-Meteo).
GOOGLE_WEATHER_API_KEY=""
